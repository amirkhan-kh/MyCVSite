---
import Icon from "./Icon.astro";
import { contacts, mentor } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__brand">
      <strong>GEEKS</strong> <span>Andijan</span>
    </p>
    <ul class="footer__links">
      <li>
        <a href={contacts.phoneHref}><Icon name="phone" size={16} />{contacts.phone}</a>
      </li>
      <li>
        <a href={contacts.instagram} target="_blank" rel="noopener noreferrer">
          <Icon name="instagram" size={16} />Instagram
        </a>
      </li>
      <li>
        <a href={contacts.telegram} target="_blank" rel="noopener noreferrer">
          <Icon name="send" size={16} />Telegram
        </a>
      </li>
    </ul>
    <p class="footer__copy">© {year} Geeks o‘quv markazi · Ustoz: {mentor.name}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: rgb(5 8 11 / 0.7);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
    padding-block: 32px;
  }

  .footer__brand {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .footer__brand span {
    color: var(--muted);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .footer__links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    color: #d6e2e7;
    transition: color 0.2s;
  }

  .footer__links a:hover {
    color: var(--accent-light);
  }

  .footer__copy {
    width: 100%;
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
