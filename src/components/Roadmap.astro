---
import Icon from "./Icon.astro";
import { roadmap } from "../data/site";
---

<section id="dastur" class="section" aria-labelledby="dastur-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{roadmap.eyebrow}</p>
      <h2 id="dastur-title" class="h2">
        4 bosqich. <span class="gradient-text">Har biri</span> oldingisining ustiga quriladi.
      </h2>
      <p class="lead">{roadmap.text}</p>
    </div>

    <div class="rail" aria-hidden="true">
      <div class="rail__fill" data-rail></div>
    </div>

    <ol class="modules" data-stagger>
      {roadmap.modules.map((m) => (
        <li class:list={["module card spot", m.featured && "glow-border module--featured"]}>
          <div class="module__top">
            <span class="module__n">Modul {m.n}</span>
            <span class="module__meta">{m.meta}</span>
          </div>
          <h3 class="module__title">{m.title}</h3>
          <p class="module__text">{m.text}</p>
          <ul class="module__points">
            {m.points.map((p) => (
              <li>
                <Icon name="check" size={14} />
                {p}
              </li>
            ))}
          </ul>
          {m.featured && <span class="module__badge">Final bosqich</span>}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .rail {
    position: relative;
    height: 2px;
    margin: 0 4% 28px;
    border-radius: 2px;
    background: var(--border);
  }

  .rail__fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--grad);
    box-shadow: 0 0 18px rgb(var(--accent-light-rgb) / 0.6);
    transform-origin: 0 50%;
  }

  .modules {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    padding: 0;
    list-style: none;
  }

  .module {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 26px 24px 28px;
    transition: translate 0.4s var(--ease);
  }

  .module:hover {
    translate: 0 -6px;
  }

  .module__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .module__n {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .module__meta {
    padding: 5px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #e3ecef;
    background: rgb(255 255 255 / 0.06);
    white-space: nowrap;
  }

  .module__title {
    margin-top: 12px;
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .module__text {
    color: var(--muted);
    font-size: 0.9375rem;
    flex: 1;
  }

  .module__points {
    display: grid;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
  }

  .module__points li {
    display: flex;
    gap: 8px;
    align-items: baseline;
  }

  .module__points :global(svg) {
    flex-shrink: 0;
    translate: 0 2px;
    color: var(--accent-light);
  }

  .module--featured {
    background:
      radial-gradient(120% 80% at 100% 0%, rgb(36 86 104 / 0.55), transparent 60%),
      radial-gradient(100% 60% at 0% 100%, rgb(var(--accent-rgb) / 0.9), transparent 60%),
      rgb(8 14 18 / 0.85);
  }

  .module--featured .module__title {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .module__badge {
    position: absolute;
    top: -1px;
    left: 50%;
    translate: -50% 0;
    padding: 3px 12px 4px;
    border-radius: 0 0 10px 10px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #05080b;
    background: var(--grad);
  }

  @media (max-width: 1024px) {
    .modules {
      grid-template-columns: 1fr 1fr;
    }

    .rail {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .modules {
      grid-template-columns: 1fr;
    }
  }
</style>
