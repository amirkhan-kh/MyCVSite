---
import Logo from "./Logo.astro";
import { contacts } from "../data/site";

const links = [
  { href: "#dastur", label: "Dastur" },
  { href: "#loyihalar", label: "Loyihalar" },
  { href: "#ustoz", label: "Ustoz" },
  { href: "#format", label: "Format" },
];
---

<header class="header">
  <div class="progress" aria-hidden="true"></div>
  <div class="header__bar">
    <a class="logo" href="#main">
      <Logo />
      <span class="logo__text">
        Amirxon<span class="logo__tag">/frontend</span>
      </span>
    </a>
    <nav aria-label="Asosiy navigatsiya">
      <ul class="nav">
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="header__cta" href={contacts.telegram} target="_blank" rel="noopener noreferrer">
      Yozilish
    </a>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: 14px 20px 0;
    pointer-events: none;
  }

  .progress {
    position: fixed;
    inset: 0 0 auto;
    height: 2px;
    background: var(--grad);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .header__bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: 880px;
    margin-inline: auto;
    padding: 7px 8px 7px 8px;
    border-radius: 999px;
    background: rgb(8 16 20 / 0.6);
    box-shadow:
      0 0 0 1px var(--border) inset,
      0 20px 50px -20px rgb(0 0 0 / 0.7);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .logo__text {
    font-size: 1.0625rem;
  }

  .logo__tag {
    margin-left: 2px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--accent-light);
  }

  @media (max-width: 420px) {
    .logo__tag {
      display: none;
    }
  }

  .nav {
    display: flex;
    gap: 4px;
  }

  .nav a {
    display: block;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.9375rem;
    color: var(--muted);
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .nav a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.06);
  }

  .header__cta {
    padding: 10px 18px;
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #05080b;
    background: #f1f5f7;
    transition:
      transform 0.2s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .header__cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 30px -6px rgb(var(--accent-light-rgb) / 0.6);
  }

  @media (max-width: 720px) {
    .nav {
      display: none;
    }
  }
</style>
