---
interface Props {
  size?: number;
}

const { size = 38 } = Astro.props;
---

<svg class="logo-mark" width={size} height={size} viewBox="0 0 40 40" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="logo-bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#245668" />
      <stop offset="1" stop-color="#152e39" />
    </linearGradient>
  </defs>
  <rect width="40" height="40" rx="11" fill="url(#logo-bg)" />
  <rect x="0.5" y="0.5" width="39" height="39" rx="10.5" fill="none" stroke="#8ccbd8" stroke-opacity="0.3" />
  <g fill="none" stroke="#8ccbd8" stroke-width="1.6" stroke-linecap="round">
    <path d="M7 12V8.5A1.5 1.5 0 0 1 8.5 7H12" />
    <path d="M28 7h3.5A1.5 1.5 0 0 1 33 8.5V12" />
    <path d="M33 28v3.5a1.5 1.5 0 0 1-1.5 1.5H28" />
    <path d="M12 33H8.5A1.5 1.5 0 0 1 7 31.5V28" />
  </g>
  <path d="M13.5 28 20 12.5 26.5 28" fill="none" stroke="#f1f5f7" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
  <rect class="logo-mark__cursor" x="16.2" y="21.6" width="7.6" height="2.6" rx="1.3" fill="#a3e635" />
</svg>

<style>
  .logo-mark {
    display: block;
    flex-shrink: 0;
  }

  .logo-mark__cursor {
    animation: cursor-blink 1.2s steps(1) infinite;
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0.15;
    }
  }
</style>
