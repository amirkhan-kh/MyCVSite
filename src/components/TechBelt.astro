---
import { stackRows } from "../data/stack";

const unique = [...new Map(stackRows.flat().filter((s) => s.path).map((s) => [s.id, s])).values()];
---

<section class="belt" aria-labelledby="belt-title">
  <h2 id="belt-title" class="sr-only">Amirxon ishlaydigan texnologiyalar</h2>

  <svg class="sprite" aria-hidden="true" focusable="false">
    <defs>
      {unique.map((s) => (
        <symbol id={`i-${s.id}`} viewBox="0 0 24 24">
          <path d={s.path} />
        </symbol>
      ))}
    </defs>
  </svg>

  <ul class="sr-only">
    {stackRows.flat().map((s) => <li>{s.name}</li>)}
  </ul>

  {stackRows.map((row, r) => (
    <div class:list={["belt__row", r % 2 === 1 && "belt__row--reverse"]} aria-hidden="true">
      <div class="belt__track">
        {[0, 1].map(() => (
          <ul class="belt__list">
            {row.map((s) => (
              <li class="tech" style={`--brand:${s.brand}`}>
                {s.path ? (
                  <svg class="tech__logo" width="22" height="22" viewBox="0 0 24 24">
                    <use href={`#i-${s.id}`} />
                  </svg>
                ) : (
                  <span class="tech__logo tech__mono">{s.monogram}</span>
                )}
                <span class="tech__name">{s.name}</span>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  ))}
</section>

<style>
  .belt {
    position: relative;
    display: grid;
    gap: 14px;
    padding-block: 28px;
    overflow: hidden;
    border-block: 1px solid var(--border);
    background: linear-gradient(180deg, rgb(var(--accent-rgb) / 0.25), rgb(var(--accent-rgb) / 0.05));
  }

  .sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .belt__row {
    overflow: hidden;
    -webkit-mask: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .belt__track {
    display: flex;
    width: max-content;
    animation: marquee 60s linear infinite;
  }

  .belt__row--reverse .belt__track {
    animation-direction: reverse;
    animation-duration: 70s;
  }

  .belt__row:hover .belt__track {
    animation-play-state: paused;
  }

  .belt__list {
    display: flex;
    flex-shrink: 0;
    gap: 12px;
    padding-right: 12px;
  }

  .tech {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 20px 10px 12px;
    border-radius: 16px;
    white-space: nowrap;
    background: rgb(255 255 255 / 0.03);
    box-shadow: 0 0 0 1px var(--border) inset;
    transition:
      background-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .tech__logo {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    padding: 7px;
    border-radius: 10px;
    fill: #d6e2e7;
    color: #d6e2e7;
    background: rgb(var(--accent-rgb) / 0.9);
    box-shadow: 0 0 0 1px rgb(var(--accent-light-rgb) / 0.18) inset;
    transition:
      fill 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .tech__mono {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .tech__name {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #dbe5e9;
  }

  .tech:hover {
    background: rgb(255 255 255 / 0.06);
    box-shadow: 0 0 0 1px rgb(var(--accent-light-rgb) / 0.3) inset;
  }

  .tech:hover .tech__logo {
    fill: var(--brand);
    color: var(--brand);
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
