---
import ProjectPreview from "./ProjectPreview.astro";
import { projects } from "../data/site";
---

<section id="loyihalar" class="section" aria-labelledby="loyihalar-title">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">{projects.eyebrow}</p>
      <h2 id="loyihalar-title" class="h2">
        Kursdan <span class="gradient-text">3 ta tayyor loyiha</span> bilan chiqasiz
      </h2>
    </div>

    <ul class="projects" data-stagger>
      {projects.items.map((p) => (
        <li
          class:list={["project card spot", p.featured && "glow-border"]}
          style={`--h:${p.hue}`}
        >
          <div class="preview" aria-hidden="true">
            {p.url && (
              <div class="preview__bar">
                <i></i><i></i><i></i>
                <span class="preview__url">{p.url}</span>
              </div>
            )}
            <div class="preview__body">
              <ProjectPreview kind={p.preview} />
            </div>
          </div>
          <div class="project__body">
            <p class="project__tag">{p.tag}</p>
            <h3 class="project__title">{p.title}</h3>
            <p class="project__text">{p.text}</p>
            <ul class="project__stack">
              {p.stack.map((s) => <li>{s}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .projects {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .project {
    display: flex;
    flex-direction: column;
    transition: translate 0.45s var(--ease);
  }

  .project:hover {
    translate: 0 -8px;
  }

  .preview {
    position: relative;
    display: flex;
    flex-direction: column;
    margin: 14px 14px 0;
    height: 210px;
    border-radius: 18px;
    overflow: hidden;
    background:
      radial-gradient(90% 120% at 80% 0%, hsl(var(--h) 45% 40% / 0.55), transparent 60%),
      radial-gradient(70% 90% at 0% 100%, rgb(var(--accent-rgb) / 1), transparent 60%),
      #081014;
    box-shadow: 0 0 0 1px var(--border) inset;
  }

  .preview__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
  }

  .preview__bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.25);
  }

  .preview__url {
    flex: 1;
    max-width: 60%;
    margin-left: 10px;
    padding: 2px 10px;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 9px;
    color: #a9bcc3;
    background: rgb(255 255 255 / 0.05);
  }

  .preview__body {
    flex: 1;
    min-height: 0;
    transition: transform 0.6s var(--ease);
  }

  .project:hover .preview__body {
    transform: translateY(-4px) scale(1.02);
  }

  .project__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
    padding: 24px 26px 28px;
  }

  .project__tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: hsl(var(--h) 45% 78%);
  }

  .project__title {
    font-size: 1.625rem;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .project__text {
    flex: 1;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }

  .project__stack li {
    padding: 4px 10px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #d6e2e7;
    background: rgb(255 255 255 / 0.05);
    box-shadow: 0 0 0 1px var(--border) inset;
  }

  @media (max-width: 960px) {
    .projects {
      grid-template-columns: 1fr;
      max-width: 560px;
      margin-inline: auto;
    }
  }
</style>
